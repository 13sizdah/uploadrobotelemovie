# Token from @BotFather
BOT_TOKEN=123456789:replace-me

# Public HTTPS address without a trailing slash
PUBLIC_BASE_URL=https://download.example.com

# Files live for this many hours after upload
FILE_TTL_HOURS=24

# 0 means no application-level size limit. Local Bot API is required for large files.
MAX_FILE_SIZE_MB=0

# Web server settings
HOST=0.0.0.0
PORT=8080
DATA_DIR=/app/data
CLEANUP_INTERVAL_SECONDS=300

# Optional: comma-separated Telegram numeric user IDs. Empty means everyone.
ALLOWED_USER_IDS=

# Telegram numeric ID of the only administrator. Required when FORWARD_ONLY=true.
ADMIN_USER_ID=123456789

# Only accept media forwarded from sources configured in /admin.
FORWARD_ONLY=true

# Required by the bundled Local Telegram Bot API service.
# Get these once from https://my.telegram.org/apps (these are NOT the bot token).
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me

# Keep these values when using compose.yaml.
TELEGRAM_API_BASE=http://telegram-bot-api:8081
